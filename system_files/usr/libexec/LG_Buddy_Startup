#!/bin/bash

# ============================================================================
# LG TV Startup Script
# Turns on LG WebOS TV and switches to specified input on system boot
# ============================================================================

# UPDATE THESE: Change to match your setup
USERNAME="zany130"
ALGA_PATH="/home/${USERNAME}/.local/bin/alga"
TV_INPUT="HDMI_1"  # Change to your PC's input (e.g., HDMI_1, HDMI_2, HDMI_3, HDMI_4)

# Validate that alga executable exists and is executable
if [[ ! -x "$ALGA_PATH" ]]; then
    echo "Error: alga executable not found or not executable at $ALGA_PATH"
    exit 0
fi

# Retry up to 30 times (~90 s budget) to get a response from the TV.
# TV may take extra time to become reachable right after boot even when the
# host network is up (wait-online only guarantees host connectivity).
# Each attempt uses a 10 s timeout so a stalled network call cannot block boot.
power_state=""
MAX_ATTEMPTS=30
for i in $(seq 1 $MAX_ATTEMPTS); do
    power_state=$(timeout 10 "$ALGA_PATH" power screen-state 2>/dev/null | cut -d':' -f2 | xargs)
    if [[ -n "$power_state" ]]; then
        break
    fi
    echo "Attempt $i/$MAX_ATTEMPTS: TV not responding, retrying in 3s..."
    sleep 3
done

if [[ -z "$power_state" ]]; then
    echo "TV did not respond after $MAX_ATTEMPTS attempts; giving up"
    exit 1
fi

if [[ "$power_state" != "Active" ]]; then
    echo "Turning on TV and switching to $TV_INPUT"
    timeout 15 "$ALGA_PATH" power on
    sleep 7
    timeout 10 "$ALGA_PATH" input set "$TV_INPUT"
else
    echo "TV already on, switching to $TV_INPUT"
    timeout 10 "$ALGA_PATH" input set "$TV_INPUT"
fi
