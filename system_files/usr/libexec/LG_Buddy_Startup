#!/bin/bash

# ============================================================================
# LG TV Startup Script
# Turns on LG WebOS TV and switches to specified input on system boot
# ============================================================================

# UPDATE THESE: Change to match your setup
USERNAME="zany130"
ALGA_PATH="/home/${USERNAME}/.local/bin/alga"
TV_INPUT="HDMI_1"  # Change to your PC's input (e.g., HDMI_1, HDMI_2, HDMI_3, HDMI_4)

# Validate that alga executable exists and is executable
if [[ ! -x "$ALGA_PATH" ]]; then
    echo "Error: alga executable not found or not executable at $ALGA_PATH"
    exit 0
fi

# Temporary workaround for upstream alga bug where `power screen-state` can
# crash with JSONDecodeError when the TV is off/unresponsive:
# https://github.com/Tenzer/alga/issues/353
#
# Instead of probing screen-state, directly attempt the intended actions with
# bounded retries and explicit command error logging.
MAX_ATTEMPTS=30
RETRY_DELAY=3
RETRY_BUDGET_SECONDS=90
ALGA_TIMEOUT=3
START_TIME=$(date +%s)
ATTEMPTS_MADE=0

run_alga() {
    local attempt="$1"
    shift

    local output rc cmd_display
    output=$(timeout "$ALGA_TIMEOUT" "$ALGA_PATH" "$@" 2>&1)
    rc=$?
    cmd_display=$(printf '%q ' "$ALGA_PATH" "$@")
    cmd_display=${cmd_display% }

    if [[ $rc -ne 0 ]]; then
        if [[ -z "$output" ]]; then
            output="(no output)"
        fi
        echo "Attempt ${attempt}/${MAX_ATTEMPTS}: '${cmd_display}' failed (exit=${rc}): ${output}"
        return $rc
    fi

    return 0
}

for attempt in $(seq 1 "$MAX_ATTEMPTS"); do
    elapsed=$(( $(date +%s) - START_TIME ))
    remaining=$(( RETRY_BUDGET_SECONDS - elapsed ))
    if (( remaining <= 0 || remaining < (ALGA_TIMEOUT * 2) )); then
        ATTEMPTS_MADE=$((attempt - 1))
        echo "Retry budget (${RETRY_BUDGET_SECONDS}s) exhausted before attempt ${attempt}/${MAX_ATTEMPTS}"
        break
    fi

    ATTEMPTS_MADE=$attempt

    if run_alga "$attempt" power on && run_alga "$attempt" input set "$TV_INPUT"; then
        echo "TV command sequence succeeded on attempt ${attempt}/${MAX_ATTEMPTS}"
        exit 0
    fi

    elapsed=$(( $(date +%s) - START_TIME ))
    if (( attempt < MAX_ATTEMPTS && elapsed + RETRY_DELAY < RETRY_BUDGET_SECONDS )); then
        echo "Attempt ${attempt}/${MAX_ATTEMPTS}: TV not ready yet, retrying in ${RETRY_DELAY}s..."
        sleep "$RETRY_DELAY"
    else
        if (( attempt < MAX_ATTEMPTS )); then
            echo "Retry budget nearly exhausted after attempt ${attempt}/${MAX_ATTEMPTS}; stopping retries"
        fi
        break
    fi
done

elapsed=$(( $(date +%s) - START_TIME ))
echo "TV did not accept startup commands after ${ATTEMPTS_MADE} attempt(s) in ${elapsed}s (budget ${RETRY_BUDGET_SECONDS}s); giving up"
exit 1
