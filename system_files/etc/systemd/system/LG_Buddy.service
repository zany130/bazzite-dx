[Unit]
Description=Controls LG WebOS TV at Startup and Shutdown
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=true
User=zany130
Group=zany130
ExecStart=/usr/libexec/LG_Buddy_Startup
ExecStop=/usr/libexec/LG_Buddy_Shutdown
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=15
# Hard cap: give up after 180 s to cover worst-case startup (retries + power-on delay + input switch)
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
