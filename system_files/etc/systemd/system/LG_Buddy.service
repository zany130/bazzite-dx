[Unit]
Description=Controls LG WebOS TV at Startup and Shutdown
Wants=network-online.target
After=network-online.target NetworkManager-wait-online.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=zany130
Group=zany130
ExecStart=/usr/libexec/LG_Buddy_Startup
ExecStop=/usr/libexec/LG_Buddy_Shutdown
StandardOutput=journal
StandardError=journal
# Script handles all retries internally; no systemd restart loop for oneshot
Restart=no
# Hard cap: covers full script retry budget (~90 s) + power-on delay + input switch
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
