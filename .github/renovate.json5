{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  platformAutomerge: true,
  rebaseWhen: 'never',
  customManagers: [
    {
      // Matches inline `# renovate: datasource=... depName=...` annotations in build.sh.
      // Restrict to github-releases so the digest-aware manager below is the
      // only match for rEFInd_GUI.
      customType: 'regex',
      managerFilePatterns: [
        '/^build_files/build\\.sh$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)[^\\n]*\\n[A-Z_]+_VERSION="(?<currentValue>[^"]+)"',
      ],
      versioningTemplate: 'loose',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^build_files/build\\.sh$/'],
      matchStrings: [
        '# renovate: datasource=github-release-attachments depName=jlobue10/rEFInd_GUI\\nREFIND_GUI_VERSION="(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"\\nREFIND_GUI_SHA256="(?<currentDigest>[a-f0-9]{64})"',
      ],
      datasourceTemplate: 'github-release-attachments',
      depNameTemplate: 'jlobue10/rEFInd_GUI',
      versioningTemplate: 'loose',
    },
  ],
  packageRules: [
    {
      matchDatasources: ['github-release-attachments'],
      matchPackageNames: ['jlobue10/rEFInd_GUI'],
      // Keep the source-checksum workflow's allowlist stable for future majors.
      branchTopic: 'jlobue10-refind_gui-{{{newMajor}}}.x',
      pinDigests: true,
      automerge: false,
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'zany130/cockpit-probe',
        'zany130/cockpit-diagnostics',
      ],
      extractVersion: '^[Vv]?(?<version>\\d+\\.\\d+(?:\\.\\d+)?)$',
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'realmcuser/cockpit-nspawn',
      ],
      // Upstream started publishing tags like `cockpit-nspawn-v1.0.0-70`;
      // normalize both prefixed and plain tags to keep updates flowing.
      extractVersion: '^(?:cockpit-nspawn-)?(?<version>v\\d+\\.\\d+\\.\\d+-\\d+)$',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/ublue-os/bazzite-deck',
      ],
      automerge: true,
    },
  ],
}
